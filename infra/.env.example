# Copy to ../.env (repo root) and fill in. Never commit real values. Keep the file private: chmod 600 .env
# Staging and prod refuse to start on dev defaults or weak secrets (lens.core.settings, ADR-0042).

APP_ENV=dev                     # dev | test | staging | prod
LOG_LEVEL=INFO                  # DEBUG is refused outside dev
WEB_ORIGIN=http://localhost:3000   # the only CORS origin; https:// required when deployed

# Data stores. Deployed: TLS for Postgres (?sslmode=require), a password for Redis, an API key for Qdrant.
DATABASE_URL=postgresql+psycopg://lens:lens@localhost:5433/lens
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Admin API (/api/v1/admin/*): at least 32 random characters, e.g. `openssl rand -hex 32`. Empty disables admin.
ADMIN_TOKEN=
# Shared by every API worker so rate limits count per reader, not per worker. Required when deployed.
RATE_LIMIT_SALT=
MAX_BODY_BYTES=1000000

# LLM providers (config/models.yaml). Gemini is the fallback.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=                 # Ask's own quota (ADR-0032)
GEMINI_API_KEY=
SARVAM_API_KEY=
LLM_TIMEOUT_S=120

# Fact-checks (Google Fact Check Tools API, ADR-0040)
GOOGLE_FACTCHECK_API_KEY=

# LangSmith tracing (inputs and outputs are PII-masked before they leave, G-OUT-05)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lens-dev

# Ingestion: an honest user agent; robots.txt is matched against the token.
INGEST_USER_AGENT=LensBot/0.1 (news comparison research prototype)
INGEST_ROBOTS_TOKEN=LensBot
INGEST_DEFAULT_INTERVAL_MIN=15
INGEST_TRACE=false

# Reserved, not read by the code yet (licensed news APIs, docs/13; Bhashini translation, ADR-0040).
# NEWS_API_KEYS=
# BHASHINI_KEYS=

# Google sign-in (ADR-0044). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <API_PUBLIC_URL>/api/v1/auth/google/callback. Unset = sign-in hidden.
API_PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
